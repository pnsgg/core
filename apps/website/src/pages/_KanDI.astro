---
import ArlequinKanDI from '@/assets/ArlequinKanDI.svg';
import BanderoleInfoKanDI from '@/assets/BanderoleInfoKanDI.svg';
import LogoKanDI from '@/assets/logos/KanDI.svg';
import Button from '@/components/Button.astro';
---

<section id="kandi">
  <div class="en-tete">
    <LogoKanDI />

    <div class="infos-rapides" aria-hidden="true">
      <div class="date">Samedi 18 avril 2026</div>

      <div class="lieu">Université de Toulouse</div>

      <BanderoleInfoKanDI />
    </div>
  </div>

  <div class="infos">
    <p>
      Le tournoi mensuel <span style="color: var(--rouge-pns)">try-hard</span>
      à l’Université de Toulouse.
    </p>

    <ul>
      <li>64 places</li>
      <li>Tournoi de la seconde chance</li>
      <li>Buvette sur place</li>
    </ul>

    <div role="list" class="infos-rapides-mobile">
      <ArlequinKanDI />

      Samedi 18 avril à l'Université de Toulouse
    </div>

    <Button href="https://start.gg/kandi"> Inscriptions sur Start.gg </Button>
  </div>
</section>

<style lang="scss">
  #kandi {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 2rem;

    font-family: 'National Park', var(--polices-defaut);

    background-image: url(/assets/fond-kandi.webp);
    background-size: cover;
    background-position: center;

    min-height: 400px;

    @media (max-width: 870px) {
      flex-direction: column;
      padding: 0.5rem;
      padding-top: 2rem;

      :global(#logo-kandi) {
        scale: 1.1;
      }
    }

    .en-tete {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      flex-shrink: 0;

      .infos-rapides {
        position: relative;
        font-weight: 600;
        color: var(--noir);

        @media (max-width: 870px) {
          display: none;
        }

        .date,
        .lieu {
          position: absolute;
          top: 50%;
          transform: translateY(calc(-50% - 1px));
          width: 220px;
          text-align: center;
        }

        .date {
          left: 0;
        }

        .lieu {
          right: 0;
        }
      }
    }

    .infos {
      display: flex;
      flex-direction: column;
      gap: 1rem;

      background-color: var(--blanc);
      color: var(--noir);

      border: 1px solid var(--noir);
      border-radius: 2.75rem;
      padding: 1rem;
      padding-top: 1.5rem;

      box-shadow: 0 2px var(--noir);

      p {
        font-size: 1.5rem;
        text-align: center;
        font-weight: 600;
        text-wrap: balance;
      }

      li a {
        color: var(--rouge-pns);
        text-decoration: underline;

        &:hover {
          text-decoration: none;
        }
      }

      ul {
        padding-inline: 1.25rem;
      }

      .infos-rapides-mobile {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;

        font-weight: 600;
        font-size: 1.125rem;
        text-wrap: balance;

        :global(svg) {
          width: 28px;
        }

        @media (max-width: 870px) {
          display: flex;
        }
      }
    }
  }
</style>
