---
import BaseLayout from '../layouts/BaseLayout.astro';
import APropos from './_APropos.astro';
import Benevolat from './_Benevolat.astro';
import BloomBagarre from './_BloomBagarre.astro';
import SmashRecap from './_SmashRecap.astro';
---

<BaseLayout
  title="PNS"
  description="PNS est une association étudiante toulousaine qui organise des événements décalés et originaux de jeux vidéo grand public."
>
  <main>
    <!-- <Jouliasard /> -->

    <!-- <KanDI /> -->

    <BloomBagarre />

    <SmashRecap />

    <Benevolat />

    <APropos />
  </main>
</BaseLayout>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
    padding-inline: 1rem;

    max-width: 950px;
    width: 100%;
  }

  :global(section) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background-color: var(--couleur-section);
    color: var(--couleur-texte);
    border-radius: 1.5rem;
    padding: 1.5rem;
  }
</style>
