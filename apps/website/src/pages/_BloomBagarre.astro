---
import CalendarFilled from '@/assets/icons/CalendarFilled.svg';
import GroupFilled from '@/assets/icons/GroupFilled.svg';
import RoadMapFilled from '@/assets/icons/RoadMapFilled.svg';
import TimeFilled from '@/assets/icons/TimeFilled.svg';
import LogoBloomBagarre from '@/assets/logos/BloomBagarre.svg';
import Button from '@/components/Button.astro';
---

<section id="bloombagarre">
  <div class="a-propos">
    <LogoBloomBagarre />

    <h2>BloomBagarre est le bimensuel expérimental à l’Université de Toulouse.</h2>
  </div>

  <div class="infos-inscriptions">
    <ul>
      <li>
        <CalendarFilled />

        <div class="valeurs">
          <span class="libelle"> Date </span>

          <span class="valeur"> Un vendredi sur deux </span>
        </div>
      </li>
      <li>
        <TimeFilled />

        <div class="valeurs">
          <span class="libelle"> Horaires </span>

          <span class="valeur"> 19h — 23h </span>
        </div>
      </li>
      <li>
        <RoadMapFilled />

        <div class="valeurs">
          <span class="libelle"> Lieu </span>

          <span class="valeur"> Université de Toulouse </span>
        </div>
      </li>
      <li>
        <GroupFilled />

        <div class="valeurs">
          <span class="libelle"> Public </span>

          <span class="valeur">
            Tous publics (étudiants et extérieur), débutants à niveaux confirmés
          </span>
        </div>
      </li>
    </ul>

    <div class="boutons">
      <Button href="https://start.gg/bloombagarre" variante="primaire">
        Infos et billetterie
      </Button>
    </div>
  </div>
</section>

<style lang="scss">
  #bloombagarre {
    flex-direction: row;
    gap: 3rem;

    font-family: 'Instrument Sans', var(--polices-defaut);

    @media (max-width: 870px) {
      flex-direction: column;
    }

    .a-propos {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      width: 100%;

      @media (max-width: 870px) {
        align-items: center;
      }

      svg {
        width: 100%;
        max-width: 410px;
      }

      h2 {
        font-family: 'Space Grotesk', var(--polices-defaut);
        max-width: 30ch;
        text-wrap: balance;

        @media (max-width: 870px) {
          text-align: center;
          max-width: none;
        }
      }
    }

    .infos-inscriptions {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      width: 100%;

      ul {
        display: contents;

        li {
          display: flex;
          gap: 1rem;
          text-wrap: balance;

          @media (max-width: 870px) {
            align-items: center;
          }

          .valeurs {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;

            .libelle {
              font-size: 1.25rem;
              font-weight: 600;
              font-variation-settings: 'wdth' 85;

              @media (max-width: 870px) {
                display: none;
              }
            }

            .valeur {
              @media (max-width: 870px) {
                font-size: 1.25rem;
                font-weight: 600;
                font-variation-settings: 'wdth' 85;
              }
            }
          }
        }
      }

      .boutons {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
    }
  }
</style>
